[Unit]
Description=AGS Bot Status Central
After=network-online.target mysql.service
Wants=network-online.target
[Service]
Type=simple
User=agsmonitor
WorkingDirectory=/opt/ags-status-monitor
EnvironmentFile=/opt/ags-status-monitor/.env
ExecStart=/opt/ags-status-monitor/venv/bin/python /opt/ags-status-monitor/central.py
Restart=always
RestartSec=10
NoNewPrivileges=true
[Install]
WantedBy=multi-user.target
