# Central: copy to .env on central VPS; never commit real secrets
BOT_TOKEN=
CHANNEL_ID=
OWNER_ID=
MYSQL_HOST=127.0.0.1
MYSQL_USER=ags_monitor
MYSQL_PASSWORD=
MYSQL_DB=ags_monitor
AGENT_KEYS=server1:REPLACE_WITH_RANDOM_KEY,server2:ANOTHER_RANDOM_KEY
BIND_HOST=127.0.0.1
BIND_PORT=8787
# Agent: use a separate .env on each monitored VPS
SERVER_ID=server1
SERVER_NAME=Main VPS
CENTRAL_URL=https://monitor.example.com
AGENT_KEY=REPLACE_WITH_RANDOM_KEY
AGENT_INTERVAL=60
